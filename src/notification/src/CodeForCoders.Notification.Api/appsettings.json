{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=code_for_coders_notification;Username=code_for_coders_notification"
  },
  "OpenTelemetry": {
    "ServiceName": "CodeForCoders.Notification"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "notification.events",
    "DeadLetterExchange": "notification.events.dlx",
    "HeartbeatQueue": "notification.platform-heartbeat",
    "SendRequestQueue": "notification.envio-solicitado",
    "SendRequestRoutingKey": "notificacao.envio-solicitado.v1",
    "PrefetchCount": 10,
    "DeliveryLimit": 5
  },
  "Delivery": {
    "PollingIntervalSeconds": 1
  },
  "Outbox": {
    "PollingIntervalSeconds": 2,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Valkey": {
    "ConnectionString": "localhost:6379,abortConnect=false"
  },
  "Email": {
    "Endpoint": "https://email.example.invalid/v1/send",
    "FromAddress": "notifications@example.invalid",
    "SendingDomain": "example.invalid",
    "ValidityHoursByPurpose": {
      "confirmacao-de-conta": 24,
      "recuperacao-de-senha": 1
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Error",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning"
    }
  },
  "AllowedHosts": "*"
}
