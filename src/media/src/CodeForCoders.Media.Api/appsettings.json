{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=code_for_coders_media;Username=code_for_coders_media"
  },
  "OpenTelemetry": {
    "ServiceName": "CodeForCoders.Media"
  },
  "MediaTokens": {
    "Issuer": "identity",
    "Audience": "media",
    "JwksUrl": "http://localhost:5101/internal/v1/jwks"
  },
  "AwsMedia": {
    "Region": "us-east-1",
    "BucketName": "code-for-coders-media",
    "ObjectKeyPrefix": "media",
    "ForcePathStyle": false
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "media.events",
    "DeadLetterExchange": "media.events.dlx",
    "HeartbeatQueue": "media.platform-heartbeat",
    "PrefetchCount": 10,
    "DeliveryLimit": 5
  },
  "Outbox": {
    "PollingIntervalSeconds": 2,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Preparation": {
    "WorkDirectory": "/var/lib/media-work",
    "PollingIntervalSeconds": 10,
    "MaxConcurrency": 1,
    "LeaseDurationSeconds": 300,
    "LeaseRenewalIntervalSeconds": 60,
    "CleanupBatchSize": 100,
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe"
  },
  "Valkey": {
    "ConnectionString": "localhost:6379,abortConnect=false"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Error",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning"
    }
  },
  "AllowedHosts": "*"
}
