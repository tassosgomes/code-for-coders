# Confirmation and password reset links carry a one-time token in the query string.
# Log the path only (no query string, no Referer, which repeats the page URL) so no token reaches the logs.
map $request_uri $request_path_without_query {
    "~^(?<request_path>[^?]*)" $request_path;
    default                    "-";
}

log_format student_spa_no_query '$remote_addr - $remote_user [$time_local] '
                                '"$request_method $request_path_without_query $server_protocol" '
                                '$status $body_bytes_sent "$http_user_agent"';

server {
    listen      80;
    server_name _;

    access_log /var/log/nginx/access.log student_spa_no_query;

    location /api/v1/ {
        proxy_pass http://bff-student:8080;
        proxy_http_version 1.1;
        proxy_set_header Host bff-student:8080;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /v1/student/ {
        proxy_pass http://bff-student:8080;
        proxy_http_version 1.1;
        proxy_set_header Host bff-student:8080;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ${BASE_PATH} {
        alias /usr/share/nginx/html/;
        try_files $uri $uri/ ${BASE_PATH}index.html;
    }

    location = ${BASE_PATH}runtime-env.js {
        alias /usr/share/nginx/html/runtime-env.js;
        add_header Cache-Control "no-store";
    }

    location = ${BASE_PATH}index.html {
        alias /usr/share/nginx/html/index.html;
        add_header Cache-Control "no-store";
    }

    location ${BASE_PATH}assets/ {
        alias /usr/share/nginx/html/assets/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /healthz {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }
}
