{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=code_for_coders_bff_admin;Username=code_for_coders_bff_admin"
  },
  "OpenTelemetry": {
    "ServiceName": "CodeForCoders.BffAdmin"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "bff-admin.events",
    "DeadLetterExchange": "bff-admin.events.dlx",
    "HeartbeatQueue": "bff-admin.platform-heartbeat",
    "PrefetchCount": 10,
    "DeliveryLimit": 5
  },
  "Outbox": {
    "PollingIntervalSeconds": 2,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Valkey": {
    "ConnectionString": "localhost:6379,abortConnect=false"
  },
  "BffSecurity": {
    "SessionCookieName": "staff_session",
    "CsrfHeaderName": "X-CSRF-Token",
    "AllowedOrigins": ["http://localhost:8081"],
    "SessionKeyPrefix": "bff-admin:session:",
    "SessionTtlMinutes": 60,
    "ProxyAudience": "",
    "SessionCookieHttpOnly": true,
    "SessionCookieSecure": true,
    "SessionCookieSameSite": "Lax",
    "UseOpaqueSessions": true,
    "BrowserReceivesAccessToken": false,
    "ReverseProxy": "YARP"
  },
  "StaffIdentity": {
    "BaseAddress": "http://localhost:5101/",
    "Issuer": "bff-admin",
    "Audience": "identity-internal",
    "SigningKeyId": "local-dev-1",
    "SigningKeyBase64": "",
    "TenantId": "00000000-0000-7000-8000-000000000001"
  },
  "Commerce": {
    "BaseAddress": "http://localhost:5104/"
  },
  "ReverseProxy": {
    "Routes": {
      "admin-backend": {
        "ClusterId": "admin-backend",
        "Match": { "Path": "/proxy/{**catch-all}" }
      }
    },
    "Clusters": {
      "admin-backend": {
        "Destinations": {
          "destination": { "Address": "http://localhost:5102/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Error",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning"
    }
  },
  "AllowedHosts": "*"
}
