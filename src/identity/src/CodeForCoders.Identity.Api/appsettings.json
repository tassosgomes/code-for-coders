{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=code_for_coders_identity;Username=code_for_coders_identity"
  },
  "OpenTelemetry": {
    "ServiceName": "CodeForCoders.Identity"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "identity.events",
    "NotificationExchange": "notification.events.default",
    "AuditExchange": "audit.events",
    "DeadLetterExchange": "identity.events.dlx",
    "HeartbeatQueue": "identity.platform-heartbeat",
    "PrefetchCount": 10,
    "DeliveryLimit": 5
  },
  "Outbox": {
    "PollingIntervalSeconds": 2,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Valkey": {
    "ConnectionString": "localhost:6379,abortConnect=false"
  },
  "StudentAccount": {
    "ConfirmationBaseUrl": "http://localhost:8082/student/confirm-account",
    "ConfirmationLifetimeHours": 24,
    "PasswordResetBaseUrl": "http://localhost:8082/student/redefinir-senha",
    "PasswordResetLifetimeHours": 1
  },
  "StaffAccount": {
    "PasswordResetBaseUrl": "http://localhost:8081/admin/redefinir-senha",
    "PasswordResetLifetimeHours": 1
  },
  "StaffInvitation": {
    "AcceptanceBaseUrl": "http://localhost:8081/admin/convite",
    "LifetimeHours": 168
  },
  "StudentSession": {
    "InactivityTimeoutMinutes": 60
  },
  "StaffSession": {
    "InactivityTimeoutMinutes": 60
  },
  "StudentSessionTokens": {
    "Issuer": "identity",
    "SigningKeyId": "",
    "SigningKeyBase64": "",
    "LifetimeMinutes": 5,
    "AudienceScopes": {}
  },
  "StaffSessionTokens": {
    "Issuer": "identity",
    "SigningKeyId": "",
    "SigningKeyBase64": "",
    "LifetimeMinutes": 5,
    "AudienceScopes": {}
  },
  "Idempotency": {
    "FingerprintKeyBase64": ""
  },
  "OutboxProtection": {
    "KeyBase64": ""
  },
  "ServiceAssertions": {
    "Audience": "identity-internal",
    "Issuers": {
      "bff-student": {
        "PublicKeys": {},
        "AllowedScopes": [
          "student-accounts:create",
          "student-accounts:confirm",
          "student-accounts:request-confirmation",
          "student-sessions:create",
          "student-sessions:validate",
          "student-sessions:revoke",
          "student-password-resets:request",
          "student-password-resets:execute",
          "student-password-changes:execute"
        ],
        "AllowedTenantIds": []
      },
      "bff-admin": {
        "PublicKeys": {},
        "AllowedScopes": [
          "staff-sessions:create",
          "staff-sessions:validate",
          "staff-sessions:revoke",
          "staff-passwords:reset",
          "staff-invitations:read",
          "staff-invitations:write",
          "staff-members:read",
          "staff-members:write"
        ],
        "AllowedTenantIds": []
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Error",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning"
    }
  },
  "AllowedHosts": "*"
}
