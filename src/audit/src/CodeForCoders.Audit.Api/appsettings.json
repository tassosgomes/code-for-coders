{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=code_for_coders_audit;Username=code_for_coders_audit"
  },
  "OpenTelemetry": {
    "ServiceName": "CodeForCoders.Audit"
  },
  "AuditDatabase": {
    "WriterRole": "code_for_coders_audit_writer"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "audit.events",
    "DeadLetterExchange": "audit.events.dlx",
    "AuditQueue": "audit.audit-event",
    "EventRoutingKey": "audit.audit.event.v1",
    "PrefetchCount": 10,
    "DeliveryLimit": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Error",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning"
    }
  },
  "AllowedHosts": "*"
}
