{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=code_for_coders_bff_student;Username=code_for_coders_bff_student"
  },
  "OpenTelemetry": {
    "ServiceName": "CodeForCoders.BffStudent"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "bff-student.events",
    "DeadLetterExchange": "bff-student.events.dlx",
    "HeartbeatQueue": "bff-student.platform-heartbeat",
    "PrefetchCount": 10,
    "DeliveryLimit": 5
  },
  "Outbox": {
    "PollingIntervalSeconds": 2,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Valkey": {
    "ConnectionString": "localhost:6379,abortConnect=false"
  },
  "BffSecurity": {
    "SessionCookieName": "__Host-bff-student-session",
    "CsrfCookieName": "bff-student-csrf",
    "CsrfHeaderName": "X-CSRF-TOKEN",
    "SessionKeyPrefix": "bff-student:session:",
    "SessionTtlMinutes": 60,
    "SessionCookieHttpOnly": true,
    "SessionCookieSecure": true,
    "SessionCookieSameSite": "Lax",
    "UseOpaqueSessions": true,
    "BrowserReceivesAccessToken": false,
    "ReverseProxy": "YARP"
  },
  "ReverseProxy": {
    "Routes": {
      "student-backend": {
        "ClusterId": "student-backend",
        "Match": { "Path": "/proxy/{**catch-all}" }
      }
    },
    "Clusters": {
      "student-backend": {
        "Destinations": {
          "destination": { "Address": "http://localhost:5101/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Error",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning"
    }
  },
  "AllowedHosts": "*"
}
